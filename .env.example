# Copia este archivo como .env y cambia los valores antes de levantar los contenedores
APP_PORT=80

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
